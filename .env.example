# Copy to .env. Everything has a working local default.

# Postgres (the docker-compose instance) and the API listen address.
# DATABASE_URL=postgres://loganalyzer:loganalyzer@127.0.0.1:5447/loganalyzer
# BIND_ADDR=127.0.0.1:3000
# RUST_LOG=info

# The site's own URL and name (the shared `name` prop, the page titles).
# APP_URL=https://loganalyzer.eve-telescope.com
# APP_NAME="EVE Log Analyzer"

# Where the raw logs are kept ({uuid}.txt.gz), and the largest log
# accepted in MiB (the request limit is 1 MiB more, for the form).
# LOG_STORAGE_DIR=storage/combat-logs
# UPLOAD_MAX_SIZE_MB=25

# ESI, for the pilot and ship ids. A chunk of names is tried twice, 250 ms
# apart, each try limited to 5 seconds; a chunk that still fails stays
# unresolved and the upload goes on. The User-Agent names the site.
# ESI_BASE_URL=https://esi.evetech.net
# ESI_USER_AGENT="EVE Log Analyzer/1.0 (+https://loganalyzer.eve-telescope.com; +https://github.com/eve-telescope/loganalyzer)"
# ESI_TRIES=2
# ESI_RETRY_DELAY_MS=250
# ESI_TIMEOUT_MS=5000

# Tests only.
# TEST_DATABASE_URL=postgres://loganalyzer:loganalyzer@127.0.0.1:5447/loganalyzer_test
