#!/usr/bin/env python3
"""The differential check of the parser: the PHP parser (in the Laravel
reference checkout, scripts/laravel-reference/run.sh setup) and the Rust
parser (src/bin/parse_logs.rs) over the same logs, reporting how many
parse differently. Only counts and names are printed, never contents,
so it can run over stored raw logs.

    scripts/parser-diff                      fresh generated logs (seed 1, 2000 logs)
    scripts/parser-diff --seed 7 --count 5000
    scripts/parser-diff DIR                  every *.txt and *.txt.gz in DIR

The documented differences (FIXES.md) are not counted: logs PHP failed
on, and a ticker or ship named "0" that PHP dropped.
"""

import argparse
import base64
import gzip
import json
import os
import random
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)
sys.path.insert(0, os.path.join(HERE, "laravel-reference"))
import parser_corpus  # noqa: E402


def php(logs):
    result = subprocess.run(
        [os.path.join(HERE, "laravel-reference/run.sh"), "php",
         os.path.join(HERE, "laravel-reference/parse.php")],
        input=json.dumps(logs).encode(), capture_output=True, check=True,
    )
    return json.loads(result.stdout)


def rust(logs):
    result = subprocess.run(
        ["cargo", "run", "--quiet", "--release", "--bin", "parse_logs"],
        cwd=REPO, input=json.dumps(logs).encode(), capture_output=True, check=True,
    )
    return json.loads(result.stdout)


def explained(expected, actual):
    """PHP's answer with the documented "0" differences applied."""
    expected = json.loads(json.dumps(expected))
    for want, got in zip(expected.get("events", []), actual.get("events", [])):
        for field in ("corporation", "shipName"):
            if want.get(field) is None and got.get(field) == "0":
                want[field] = "0"
    return expected


def batches(logs, limit=20_000_000):
    """The logs in groups of about `limit` bytes of base64, so the PHP
    side stays inside its memory limit on a directory of real logs."""
    batch, size = {}, 0
    for name, encoded in logs.items():
        if batch and size + len(encoded) > limit:
            yield batch
            batch, size = {}, 0
        batch[name] = encoded
        size += len(encoded)
    if batch:
        yield batch


def events(result):
    return len(result.get("events", [])) if "error" not in result else "error"


def main():
    arguments = argparse.ArgumentParser()
    arguments.add_argument("directory", nargs="?")
    arguments.add_argument("--seed", type=int, default=1)
    arguments.add_argument("--count", type=int, default=2000)
    options = arguments.parse_args()

    logs = {}
    if options.directory:
        for name in sorted(os.listdir(options.directory)):
            path = os.path.join(options.directory, name)
            if name.endswith(".txt.gz"):
                data = gzip.open(path).read()
            elif name.endswith(".txt"):
                data = open(path, "rb").read()
            else:
                continue
            logs[name] = base64.b64encode(data).decode()
    else:
        rng = random.Random(options.seed)
        for index in range(options.count):
            logs[f"log-{index:05d}"] = base64.b64encode(parser_corpus.random_log(rng).encode()).decode()

    expected, actual = {}, {}
    for batch in batches(logs):
        expected.update(php(batch))
        actual.update(rust(batch))
    php_failed = [name for name in logs if "error" in expected[name]]
    different = [
        name for name in logs
        if name not in php_failed and explained(expected[name], actual[name]) != actual[name]
    ]
    print(f"logs: {len(logs)}")
    print(f"PHP failed (fixed, FIXES.md): {len(php_failed)}")
    print(f"parsed differently: {len(different)}")
    for name in different[:50]:
        print(f"  {name}: events PHP {events(expected[name])}, Rust {events(actual[name])}")
    sys.exit(1 if different else 0)


main()
