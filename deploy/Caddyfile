# The production site block for the shared Caddy. Same routing as
# Caddyfile.dev: keep the path list in sync with frontend/proxy-paths.ts.
# Backend paths, and every request that is not a GET or HEAD (the upload
# and the regeneration), go to the api.

loganalyzer.eve-telescope.com {
	encode zstd gzip
	header {
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options nosniff
	}
	# Logs of up to 25 MiB with room for the form around them; the api
	# answers anything over its own limit with the size message.
	request_body {
		max_size 27MiB
	}

	@axum {
		path /api /api/* /up /up/* /analyze /analyze/* /storage /storage/* /logs/*/download /logs/*/regenerate
	}
	reverse_proxy @axum loganalyzer-api:3000

	@mutation {
		not method GET HEAD
	}
	reverse_proxy @mutation loganalyzer-api:3000

	reverse_proxy loganalyzer-frontend:3000
}
