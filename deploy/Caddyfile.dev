# The composed shared origin on :5317: backend paths and mutations go to
# the API container, page GETs to the SvelteKit node server. Keep the path
# list in sync with frontend/proxy-paths.ts and deploy/Caddyfile.

# The local preview (portal) proxies https://loganalyzer.test to this
# port; its X-Forwarded-Proto is kept, so page URLs say https there.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:5317 {
	encode zstd gzip
	# The security headers production sends too.
	header {
		X-Frame-Options SAMEORIGIN
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options nosniff
	}
	# Logs of up to 25 MiB with room for the form around them; the api
	# answers anything over its own limit with the size message.
	request_body {
		max_size 27MiB
	}

	@axum {
		path /api /api/* /up /up/* /analyze /analyze/* /storage /storage/* /logs/*/download /logs/*/regenerate
	}
	reverse_proxy @axum api:3000

	@mutation {
		not method GET HEAD
	}
	reverse_proxy @mutation api:3000

	reverse_proxy frontend:3000
}
